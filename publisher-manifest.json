nt-size:16px;list-style:none;display:flex;justify-content:space-between;align-items:center}\nsummary::after{content:\"+\";color:var(--mint-deep);font-size:22px;font-weight:300}\ndetails[open] summary::after{content:\"–\"}\ndetails p{margin-top:12px;color:var(--brown-mid);font-size:15px}\n\nfooter{background:var(--brown-dark);color:#C9B89E;padding:40px 24px;text-align:center;font-size:13px}\nfooter strong{color:var(--mint);display:block;margin-bottom:8px;font-size:18px}\n\n@media(max-width:768px){\n  .hero-grid > *{grid-column:1/13 !important}\n  .hero h1{font-size:48px}\n}\n</style><main>\n\n<header class=\"hero\">\n  <div class=\"hero-grid\">\n    <div class=\"brand-mark\">专线网络服务 · 第十二期</div>\n    <h1>兄弟们永远的神</h1>\n    <p class=\"hero-lede\">稳定。安静。值得托付。</p>\n    <p class=\"hero-body\">我们不做 fastest，不做 unlimited。我们只把每一 GB、每一台设备、每一条线路讲清楚。订阅前先看套餐，用不用得上，你自己判断。</p>\n    <div class=\"hero-side\">\n      <strong>03</strong>\n      本期收录三档套餐。从个人日常到团队协同，按需选择。\n    </div>\n    <nav class=\"hero-nav\">\n      <a href=\"#intro\">关于</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#usage\">使用</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<section id=\"intro\" class=\"intro\">\n  <h2>关于</h2>\n  <p>兄弟们永远的神是一个面向个人与小团队的专线网络服务。我们提供流媒体解锁、游戏加速和多设备协同接入。</p>\n  <p>不夸大，不承诺极致。把节点、流量、设备数写在明面上。你看到什么，就买到什么。</p>\n</section>\n\n<section id=\"plans\">\n  <h2>套餐</h2>\n  <div class=\"plans-list\">\n\n    <article class=\"plan-card\">\n      <div class=\"plan-head\">\n        <div>\n          <div class=\"plan-name\">基础版</div>\n        </div>\n        <div class=\"plan-price\">¥15/月<small>按年付仅需 ¥150/年</small></div>\n      </div>\n      <ul class=\"plan-features\">\n        <li>每月 100GB 极速流量</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>解锁基础流媒体</li>\n        <li>普通线路节点池</li>\n      </ul>\n    </article>\n\n    <article class=\"plan-card featured\">\n      <div class=\"plan-head\">\n        <div>\n          <div class=\"plan-name\">旗舰版<span class=\"plan-tag\">推荐</span></div>\n        </div>\n        <div class=\"plan-price\">¥35/月<small>按年付仅需 ¥350/年</small></div>\n      </div>\n      <ul class=\"plan-features\">\n        <li>每月 300GB 极速流量</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7x24 优先工单支持</li>\n      </ul>\n    </article>\n\n    <article class=\"plan-card\">\n      <div class=\"plan-head\">\n        <div>\n          <div class=\"plan-name\">团队版</div>\n        </div>\n        <div class=\"plan-price\">¥85/月<small>按年付仅需 ¥850/年</small></div>\n      </div>\n      <ul class=\"plan-features\">\n        <li>每月 1000GB 极速流量</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n    </article>\n\n  </div>\n</section>\n\n<section id=\"usage\">\n  <h2>使用</h2>\n  <div class=\"usage-grid\">\n    <div class=\"usage-step\">\n      <span class=\"num\">1</span>\n      <h3>选择套餐</h3>\n      <p>根据设备数量和流量需求，选择基础版、旗舰版或团队版。</p>\n    </div>\n    <div class=\"usage-step\">\n      <span class=\"num\">2</span>\n      <h3>获取接入信息</h3>\n      <p>订阅成功后，系统下发节点列表与配置参数。</p>\n    </div>\n    <div class=\"usage-step\">\n      <span class=\"num\">3</span>\n      <h3>配置客户端</h3>\n      <p>将订阅地址导入你惯用的客户端，按引导完成节点选择。</p>\n    </div>\n    <div class=\"usage-step\">\n      <span class=\"num\">4</span>\n      <h3>开始使用</h3>\n      <p>连接节点，访问目标服务。遇到问题可提交工单。</p>\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <h2>常见问题</h2>\n  <div class=\"faq-list\">\n\n    <details>\n      <summary>套餐流量用完后会怎样？</summary>\n      <p>流量用尽后连接将暂停，次月自动恢复。如需中途补充，可联系客服购买流量加包。</p>\n    </details>\n\n    <details>\n      <summary>可以同时在不同设备上使用吗？</summary>\n      <p>可以。基础版支持 3 台设备，旗舰版 5 台，团队版 20 台。超出限制的设备将无法连接。</p>\n    </details>\n\n    <details>\n      <summary>支持哪些客户端？</summary>\n      <p>我们提供通用订阅地址，兼容主流客户端。具体兼容性以实际测试为准，不在页面内逐一列举。</p>\n    </details>\n\n    <details>\n      <summary>年付和月付有什么区别？</summary>\n      <p>权益相同。年付在价格上有折扣，适合长期使用的用户。</p>\n    </details>\n\n    <details>\n      <summary>如何申请退款？</summary>\n      <p>请在订阅后 24 小时内、且流量使用未超过 5GB 的情况下联系客服。超出条件后将不再受理退款。</p>\n    </details>\n\n    <details>\n      <summary>节点线路会变动吗？</summary>\n      <p>会。我们会根据负载和稳定性调整节点池，订阅地址自动更新，无需手动更换。</p>\n    </details>\n\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <strong>兄弟们永远的神</strong>\n  专线网络服务 · 内容仅供参考，以实际订阅页为准\n</footer>",
